<?php

namespace App\Models;

use Illuminate\Database\Eloquent\Factories\HasFactory;
use Illuminate\Foundation\Auth\User as Authenticatable;
use Illuminate\Notifications\Notifiable;
use Tymon\JWTAuth\Contracts\JWTSubject;

class User extends Authenticatable implements JWTSubject
{
    use HasFactory, Notifiable;

    protected $fillable = [
        'nom', 'prenom', 'email', 'password', 'phone', 'adresse', 'genre', 'profile_image',
        'role', 'status', 'classe_id', 'filiere_id', 'niveau_scolaire_id', 'transport_id',
        'date_naissance', 'date_inscription', 'specialite', 'salaire', 'date_embauche', 'biographie'
    ];

    // --- Mab9awch hasOne(Etudiant) ---
    // Blast-hom ghadi n-diro des relations directes m3a l-ajzaa dyal l-madrasa:

    public function classe()
    {
        return $this->belongsTo(Classe::class, 'classe_id');
    }

    // public function filiere()
    // {
    //     return $this->belongsTo(Filiere::class, 'filiere_id');
    // }

    public function notifications()
    {
        return $this->hasMany(Notification::class);
    }

    // --- JWT Methods (Darori khallihom bach y-khdem l-Login) ---
    public function getJWTIdentifier() { return $this->getKey(); }
    public function getJWTCustomClaims() { return ['role' => $this->role]; }
}
